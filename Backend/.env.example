NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/sevanear
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Cloudinary image uploads (one variable). Copy the "API environment variable"
# from https://console.cloudinary.com/settings/api-keys
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
